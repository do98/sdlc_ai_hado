          <mxCell id="aT29" value="«backup» đầy đủ hằng ngày + WAL" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;fontStyle=2;" vertex="1" parent="a_label"><mxGeometry x="515" y="1082" width="190" height="15" as="geometry"/></mxCell>
