          <mxCell id="T177" value="IEmbeddingModel " style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontStyle=2;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;" vertex="1" parent="L_label"><mxGeometry x="1082" y="1217" width="104" height="16" as="geometry"/></mxCell>
          <mxCell id="T184" value="IDocumentParser" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontStyle=2;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;" vertex="1" parent="L_label"><mxGeometry x="1235.5" y="1293" width="99" height="16" as="geometry"/></mxCell>
