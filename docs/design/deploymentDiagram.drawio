olid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Mount vào container proxy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;cấu hình app&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Config (env / YAML)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;v0.1&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Địa chỉ OIDC/JWKS, điểm cuối AI, K=6, ngưỡng T [TBD: OQ-003], giới hạn tệp [TBD: OQ-004]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Mount vào container API&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;cấu hình worker&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Config (env / YAML)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;v0.1&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Số job đồng thời (2), thử lại 30 s / 2 phút / 10 phút (tối đa 3)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Mount vào container Worker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;bí mật&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Secret&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Khóa dịch vụ AI, mật khẩu CSDL; xoay vòng ≥ 90 ngày&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Tiêm khi khởi động từ secret manager; không nằm trong ảnh&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;schema docchat&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Data (RDBMS)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;v0.1 + migrations&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;users, documents, file_metadata, document_chunks, document_shares, chat_sessions, messages, citations, feedback, jobs, usage_events, audit_log (SAD §3.1.2)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;PostgreSQL 16 + pgvector; HNSW + GIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;bucket documents&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Data (object / file system)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;PDF gốc: documents/{owner}/{id}.pdf; không công khai&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Object Storage&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;bản sao lưu&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Data (backup)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;PostgreSQL đầy đủ hằng ngày + WAL; PDF theo ngày; mã hóa&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Kho sao lưu&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="c_L"><mxGeometry x="30" y="474" width="1440" height="500" as="geometry"/></mxCell>
          <mxCell id="c_h3" value="3. Đường truyền thông (communication path)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c_L"><mxGeometry x="30" y="994" width="600" height="22" as="geometry"/></mxCell>
          <mxCell id="c_3" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;font-family:Helvetica;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Đường truyền&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Giao thức&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Cổng&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Bảo mật&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Mục đích / băng thông&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Trình duyệt → reverse-proxy&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;HTTPS&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;443&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;TLS 1.2+ (ưu tiên 1.3)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Tải SPA, REST, SSE · [TBD: OQ-012]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Trình duyệt → IdP&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;HTTPS (OIDC)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;443&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;TLS; Authorization Code + PKCE&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Chỉ chuyển hướng đăng nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;reverse-proxy → API&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;HTTP nội bộ (SSE)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;[TBD], ví dụ 8000 [Đề xuất]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Mạng nội bộ; TLS nếu qua nhiều host&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Luồng câu trả lời theo SSE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;API / Worker → PostgreSQL&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;TCP (PostgreSQL)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;5432&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;TLS; mã hóa đĩa AES-256&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Giao dịch, truy vấn vector và toàn văn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;API / Worker → Object Storage&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;HTTPS (S3 API)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;443&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;TLS; mã hóa phía máy chủ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Tải và đọc PDF gốc&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;API → Redis (tùy chọn)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;TCP (Redis)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;6379&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Mạng nội bộ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Giới hạn tần suất, cache quyền (TTL 60 s)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;API / Worker → egress → Dịch vụ AI&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;HTTPS&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;443&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;TLS; danh sách cho phép điểm cuối&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Chỉ gửi đoạn đã lọc quyền (SAD §4.1.2) · [TBD: OQ-008]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;API → egress → IdP&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;HTTPS&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;443&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;TLS&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Lấy JWKS kiểm tra chữ ký JWT [TBD: OQ-016]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;API / Worker → nền tảng quan sát&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;OTLP&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;4317 [Đề xuất]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Mạng nội bộ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Log, metric, trace; không chứa nội dung tài liệu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Secret manager → container&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Tiêm khi khởi động&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Chỉ host&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Cơ chế cụ thể [TBD: OQ-022]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;PostgreSQL / Object Storage → Kho sao lưu&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Sao lưu / sao chép&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Mã hóa&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Đầy đủ hằng ngày + WAL; PDF theo ngày&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="c_L"><mxGeometry x="30" y="1020" width="1440" height="390" as="geometry"/></mxCell>
          <mxCell id="c_h4" value="4. Đơn vị triển khai, số bản sao và co giãn" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c_L"><mxGeometry x="30" y="1430" width="600" height="22" as="geometry"/></mxCell>
          <mxCell id="c_4" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;font-family:Helvetica;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Artifact&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Triển khai lên&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Số bản sao (pilot)&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Co giãn&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;web-client&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Máy tính người dùng (trình duyệt)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Tải từ proxy mỗi lần mở&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Không áp dụng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;reverse-proxy&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Host ứng dụng&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Dọc (đủ cho pilot); nhiều bản sao sau bộ cân bằng tải khi cần&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;app-image — API&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Host ứng dụng&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;1 ở MVP&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Ngang: thêm bản sao (không giữ trạng thái phiên, SAD §6)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;app-image — Worker&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Host ứng dụng&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;1; tối đa 2 job process_document đồng thời&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Ngang: thêm worker khi hàng đợi dài&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Redis&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Host ứng dụng&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;0 hoặc 1 (tùy chọn)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Không cần ở MVP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Máy chủ CSDL&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;1 cụm&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Dọc; xem lại ở ≈ 10⁶ đoạn (SAD §6)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Object Storage&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Nút lưu trữ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Dịch vụ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Theo dung lượng&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="c_L"><mxGeometry x="30" y="1456" width="1440" height="246" as="geometry"/></mxCell>
        </root>
      </mxGraphModel>
