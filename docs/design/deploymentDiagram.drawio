<mxfile host="app.diagrams.net" type="device">
    <diagram id="dep-prod" name="Deployment — Production">
      <mxGraphModel dx="1800" dy="1540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1540" math="0" shadow="0">
        <root>
          <mxCell id="a_0"/>
          <mxCell id="a_env" value="Environments" parent="a_0"/>
          <mxCell id="a_node" value="Nodes" parent="a_0"/>
          <mxCell id="a_art" value="Artifacts" parent="a_0"/>
          <mxCell id="a_conn" value="Communication paths" parent="a_0"/>
