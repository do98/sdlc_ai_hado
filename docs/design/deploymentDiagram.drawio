          <mxCell id="c_T" value="Đặc tả triển khai — node, artifact, đường truyền, đơn vị triển khai (v0.1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=Helvetica;whiteSpace=nowrap;" vertex="1" parent="c_L"><mxGeometry x="30" y="10" width="1400" height="28" as="geometry"/></mxCell>
          <mxCell id="c_h1" value="1. Node (phần cứng và môi trường thực thi)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="c_L"><mxGeometry x="30" y="50" width="600" height="22" as="geometry"/></mxCell>
          <mxCell id="c_1" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;font-family:Helvetica;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Node&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Loại&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;OS&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Phần cứng / tài nguyên&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;IP&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Kết nối&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Vị trí&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Máy tính người dùng&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;device&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Windows [Unverified]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Máy văn phòng hiện có&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Không áp dụng&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;LAN/VPN [TBD: OQ-012]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Văn phòng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Host ứng dụng&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;virtual (VM hoặc node container)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Linux [Đề xuất]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;4 vCPU / 12 GB RAM / 100 GB SSD [Đề xuất, chưa đo]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;[TBD: OQ-022]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Mạng nội bộ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;[TBD: OQ-008, OQ-011]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Container reverse-proxy&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;virtual · Docker&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Linux&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;0,5 vCPU / 512 MB&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Trong host&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Cổng 443, nhận từ trình duyệt người dùng&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Trong host&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Container API&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;virtual · Docker&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Linux&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;p