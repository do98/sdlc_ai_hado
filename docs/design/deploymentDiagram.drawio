          <mxCell id="R_BK" value="«storage node»&lt;br&gt;&lt;b&gt;Kho sao lưu đã mã hóa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;khôi phục theo thời điểm (PITR)&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="b_node"><mxGeometry x="1370" y="390" width="370" height="90" as="geometry"/></mxCell>
          <mxCell id="R_A1" value="«artifact»&lt;br&gt;sao lưu PostgreSQL (đầy đủ + WAL)" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=14;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="b_art"><mxGeometry x="1390" y="270" width="330" height="42" as="geometry"/></mxCell>
          <mxCell id="R_A2" value="«artifact»&lt;br&gt;bản sao PDF theo ngày" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=14;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="b_art"><mxGeometry x="1390" y="325" width="330" height="42" as="geometry"/></mxCell>
