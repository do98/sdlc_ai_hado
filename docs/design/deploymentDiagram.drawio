          <mxCell id="c_2" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;font-family:Helvetica;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Artifact&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Loại&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Phiên bản&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Phụ thuộc / nội dung&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Đường dẫn triển khai&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;reverse-proxy&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Docker image&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Nginx hoặc Traefik [Đề xuất]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Cấu hình TLS&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Trong container proxy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;web-client&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Tệp tĩnh (JS/CSS)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;v0.1&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Build từ mã nguồn SPA (TypeScript, React) [Đề xuất]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:to