          <mxCell id="a_note" value="Notes and legend" parent="a_0"/>
          <mxCell id="PROD" value="«environment» &lt;b&gt;Production (pilot)&lt;/b&gt; — một vùng · vị trí / nền tảng [TBD: OQ-008, OQ-011, OQ-022]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontFamily=Helvetica;fontSize=10;fontSize=11;" vertex="1" parent="a_env"><mxGeometry x="40" y="260" width="1440" height="1130" as="geometry"/></mxCell>
          <mxCell id="DEV" value="«device»&lt;br&gt;&lt;b&gt;Máy tính người dùng&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;OS: Windows [Unverified] · mạng LAN/VPN [TBD: OQ-012]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;Người dùng: nhân viên KD, Product Owner, quản trị viên&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="60" y="50" width="400" height="170" as="geometry"/></mxCell>
          <mxCell id="BROW" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Trình duyệt web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;Chrome / Edge, bản mới nhất và liền trước [TBD: OQ-024]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=3;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="80" y="118" width="360" height="96" as="geometry"/></mxCell>
          <mxCell id="CICD" value="«node»&lt;br&gt;&lt;b&gt;Kho image + CI/CD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;build → kiểm thử → quét → staging → phê duyệt tay → prod [Đề xuất]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;artifact: app-image v0.1, web-client v0.1&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="620" y="50" width="400" height="140" as="geometry"/></mxCell>
          <mxCell id="IDP" value="«external»&lt;br&gt;&lt;b&gt;Hệ thống xác thực công ty&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;OIDC / JWKS [TBD: OQ-016]&lt;/span&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="1540" y="40" width="240" height="130" as="geometry"/></mxCell>
          <mxCell id="AI" value="«external»&lt;br&gt;&lt;b&gt;Dịch vụ AI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;sinh văn bản + embedding [TBD: OQ-008]&lt;/span&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.5;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="1540" y="440" width="240" height="150" as="geometry"/></mxCell>
          <mxCell id="HOST" value="«virtual»&lt;br&gt;&lt;b&gt;Host ứng dụng (VM hoặc node container)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;OS: Linux · Docker/Compose [Đề xuất] · 4 vCPU / 12 GB RAM / 100 GB SSD [Đề xuất, chưa đo] · IP: [TBD: OQ-022]&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=420;spacingTop=3;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="80" y="330" width="1100" height="370" as="geometry"/></mxCell>
          <mxCell id="C_PROXY" value="«virtual»&lt;br&gt;&lt;b&gt;Container reverse-proxy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;Nginx hoặc Traefik [Đề xuất]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;0,5 vCPU / 512 MB · 1 bản sao&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=3;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="110" y="410" width="250" height="230" as="geometry"/></mxCell>
          <mxCell id="C_API" value="«virtual»&lt;br&gt;&lt;b&gt;Container API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;modular monolith · cổng HTTP [TBD]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;2 vCPU / 4 GB [Đề xuất] · 1 bản sao&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=3;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="390" y="410" width="250" height="230" as="geometry"/></mxCell>
          <mxCell id="C_REDIS" value="«virtual»&lt;br&gt;&lt;b&gt;Container Redis (tùy chọn)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;Redis 7 · 0,5 vCPU / 512 MB&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=3;dashed=1;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="670" y="410" width="200" height="230" as="geometry"/></mxCell>
          <mxCell id="C_WK" value="«virtual»&lt;br&gt;&lt;b&gt;Container Worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;cùng ảnh với API, lệnh khác&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;2 vCPU / 4 GB [Đề xuất] · 1 bản sao&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=3;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="900" y="410" width="250" height="230" as="geometry"/></mxCell>
          <mxCell id="EGRESS" value="«firewall»&lt;br&gt;&lt;b&gt;Egress gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;danh sách cho phép:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;IdP và điểm cuối dịch vụ AI&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;[Đề xuất]&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#F4CCCC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="1230" y="450" width="210" height="140" as="geometry"/></mxCell>
          <mxCell id="NET" value="«network» &lt;b&gt;Mạng nội bộ (private subnet)&lt;/b&gt; — CSDL và object storage chỉ nhận kết nối từ đây" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="80" y="770" width="1210" height="28" as="geometry"/></mxCell>
          <mxCell id="N_SEC" value="«node»&lt;br&gt;&lt;b&gt;Quản lý bí mật (secret manager)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;khóa AI, mật khẩu CSDL;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;xoay vòng ≥ 90 ngày&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#F4CCCC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="80" y="850" width="250" height="200" as="geometry"/></mxCell>
          <mxCell id="N_DB" value="«database server»&lt;br&gt;&lt;b&gt;PostgreSQL 16 + pgvector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;2 vCPU / 8 GB / 50 GB SSD mã hóa [Đề xuất]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;IP: [TBD: OQ-022]&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="360" y="850" width="290" height="200" as="geometry"/></mxCell>
          <mxCell id="N_OS" value="«storage node»&lt;br&gt;&lt;b&gt;Object Storage (S3)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;≈ 100 GB, mã hóa phía máy chủ [Đề xuất]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;bucket không công khai&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="680" y="850" width="290" height="200" as="geometry"/></mxCell>
          <mxCell id="N_OBS" value="«node»&lt;br&gt;&lt;b&gt;Nền tảng quan sát&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;log tập trung (30 ngày)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;metric Prometheus · trace OpenTelemetry&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;[Đề xuất]&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="1000" y="850" width="290" height="200" as="geometry"/></mxCell>
          <mxCell id="N_BK" value="«storage node»&lt;br&gt;&lt;b&gt;Kho sao lưu đã mã hóa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;vị trí tách khỏi CSDL [TBD: OQ-018]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333333&quot;&gt;RPO ≤ 15 phút (CSDL), ≤ 24 giờ (PDF) · RTO ≤ 4 giờ [TBD: OQ-018]&lt;/span&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="a_node"><mxGeometry x="360" y="1130" width="610" height="200" as="geometry"/></mxCell>
