          <mxCell id="T198" value="IObjectStore" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontStyle=2;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;" vertex="1" parent="L_label"><mxGeometry x="509.5" y="1325" width="81" height="16" as="geometry"/></mxCell>
          <mxCell id="T205" value="ILlmApi" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontStyle=2;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;" vertex="1" parent="L_label"><mxGeometry x="1538.5" y="1070" width="51" height="16" as="geometry"/></mxCell>
          <mxCell id="T212" value="IEmbeddingApi" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fontStyle=2;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;" vertex="1" parent="L_label"><mxGeometry x="1538.5" y="1189" width="87" height="16" as="geometry"/></mxCell>
          <mxCell id="T214" value="«serves» tệp tĩnh SPA" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;" vertex="1" parent="L_label"><mxGeometry x="520" y="446" width="124" height="16" as="geometry"/></mxCell>
          <mxCell id="T215" value="«delegate»" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;fontStyle=2;" vertex="1" parent="L_label"><mxGeometry x="395" y="884" width="60" height="14" as="geometry"/></mxCell>
          <mxCell id="TITLE" value="UML 2.0 Component Diagram — Công cụ &quot;Chat với tài liệu&quot; (MVP) · v0.1 · theo SAD §1.2, §2, §4.4" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=Helvetica;whiteSpace=nowrap;" vertex="1" parent="L_note"><mxGeometry x="10" y="4" width="1200" height="28" as="geometry"/></mxCell>
          <mxCell id="LEGEND" value="&lt;b&gt;Chú giải&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#DAE8FC&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «component» &amp;nbsp; &lt;span style=&quot;background:#FFF2CC&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «subsystem» &amp;nbsp; &lt;span style=&quot;background:#F5F5F5;border:1px solid #666666&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «external» &amp;nbsp; &lt;span style=&quot;background:#FFE6CC&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «database» &amp;nbsp; &lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; «interface»&lt;br&gt;○ quả bóng = &lt;b&gt;provided interface&lt;/b&gt; (thành phần cung cấp) · ⊃ ổ cắm = &lt;b&gt;required interface&lt;/b&gt; (thành phần cần) · ○⊃ cặp ghép = &lt;b&gt;assembly connector&lt;/b&gt;&lt;br&gt;□ nhỏ trên viền = &lt;b&gt;port&lt;/b&gt; · đường liền mảnh trong khung = &lt;b&gt;delegation connector&lt;/b&gt; · mũi tên nét đứt = phụ thuộc · khung nét đứt = thành phần tùy chọn" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="L_note"><mxGeometry x="230" y="1490" width="760" height="100" as="geometry"/></mxCell>
          <mxCell id="DEPLOY" value="&lt;b&gt;Triển khai (SAD §4.4) — chi tiết ở trang 2&lt;/b&gt;&lt;br&gt;Đơn vị triển khai: &lt;b&gt;web-client&lt;/b&gt; (tệp tĩnh) · &lt;b&gt;api&lt;/b&gt; (Application Server + Infrastructure Adapters) · &lt;b&gt;worker&lt;/b&gt; (Ingestion Worker, cùng ảnh container với api) · reverse-proxy · PostgreSQL · Object Storage · Redis (tùy chọn).&lt;br&gt;Phiên bản: v0.1 (MVP). Công nghệ cụ thể là [Đề xuất]; dịch vụ AI và IdP chờ OQ-008, OQ-016." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="L_note"><mxGeometry x="1010" y="1490" width="810" height="100" as="geometry"/></mxCell>
          <mxCell id="NOTE1" value="&lt;i&gt;Ghi chú: connector đi qua biên&lt;br&gt;subsystem được vẽ trực tiếp để dễ đọc.&lt;br&gt;Delegation connector chỉ vẽ ở:&lt;br&gt;reverse-proxy ↔ Application Server,&lt;br&gt;Web Client ↔ IdP và nhóm data-access.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="L_note"><mxGeometry x="10" y="460" width="200" height="130" as="geometry"/></mxCell>
        </root>
      </mxGraphModel>
    </diagram>
    <diagram id="comp-catalog" name="Danh mục interface và triển khai">
      <mxGraphModel dx="1400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1500" math="0" shadow="0">
        <root>
          <mxCell id="P2_0"/>
          <mxCell id="P2_L" value="Catalog" parent="P2_0"/>
          <mxCell id="P2_T" value="Danh mục interface (23) và đơn vị triển khai — Component Diagram v0.1" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=Helvetica;whiteSpace=nowrap;" vertex="1" parent="P2_L"><mxGeometry x="30" y="20" width="1300" height="28" as="geometry"/></mxCell>
          <mxCell id="P2_1" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;font-family:Helvetica;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#D5E8D4;border:1px solid #82B366;padding:4px 8px;text-align:left&quot;&gt;«interface»&lt;/th&gt;&lt;th style=&quot;background:#D5E8D4;border:1px solid #82B366;padding:4px 8px;text-align:left&quot;&gt;Thành phần cung cấp (provided)&lt;/th&gt;&lt;th style=&quot;background:#D5E8D4;border:1px solid #82B366;padding:4px 8px;text-align:left&quot;&gt;Thành phần cần (required)&lt;/th&gt;&lt;th style=&quot;background:#D5E8D4;border:1px solid #82B366;padding:4px 8px;text-align:left&quot;&gt;Giao thức / hợp đồng&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;IHttps&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;reverse-proxy&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;api-client (Web Client)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;HTTPS, TLS 1.2+ (SAD §4.1.2)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;IRestApi&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;rest-api (Application Server)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;reverse-proxy&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;REST/JSON, SSE; /api/v1 (SAD §2.4)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;IApiClient&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;api-client&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;ui-features, telemetry&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Hàm gọi API trong SPA; xử lý lỗi, hủy yêu cầu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;ITokenProvider&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;auth-client&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;api-client&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Cấp token truy cập (bộ nhớ, không dùng localStorage)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;ITelemetry&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;telemetry&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;ui-features&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Phát sự kiện PRD §5.2, không kèm nội dung&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;IOidcAuth&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Hệ thống xác thực (IdP)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;auth-client&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;OIDC Authorization Code + PKCE (OQ-016)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;IJwks&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Hệ thống xác thực (IdP)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;rest-api&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;JWKS để kiểm tra chữ ký JWT (OQ-016)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;ICache&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Redis 7 (tùy chọn)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;rest-api&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Giới hạn tần suất, cache quyền TTL 60 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;IAuthService&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;identity&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;rest-api&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Xác thực token, ánh xạ người dùng, vai trò&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;IDocumentService&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;documents&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;rest-api&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Tải lên, trạng thái, xóa mềm, chia sẻ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;IReportService&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1p