          <mxCell id="P2_2" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;font-family:Helvetica;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Đơn vị triển khai (deployable)&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Thành phần chứa&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Runtime instance (pilot)&lt;/th&gt;&lt;th style=&quot;background:#DAE8FC;border:1px solid #6C8EBF;padding:4px 8px;text-align:left&quot;&gt;Phiên bản / công nghệ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;web-client&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;ui-features, api-client, auth-client, telemetry&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Tệp tĩnh phục vụ qua reverse-proxy&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;v0.1 · TypeScript + React [Đề xuất]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;api (container)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;rest-api + 6 module + data-access, retrieval, embedding-client, llm-client&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;1 bản sao ở MVP; không giữ trạng thái phiên nên thêm bản sao không cần đổi mã&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;v0.1 · Python 3.12 + FastAPI [Đề xuất]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top