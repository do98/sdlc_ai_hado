          <mxCell id="aT33" value="«deploy» image v0.1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;fontStyle=2;" vertex="1" parent="a_label"><mxGeometry x="812" y="262" width="110" height="15" as="geometry"/></mxCell>
          <mxCell id="aTT1" value="UML 2.0 Deployment Diagram — Công cụ &quot;Chat với tài liệu&quot; (MVP) · Production (pilot) · v0.1 · theo SAD §4.4, §4.2" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=Helvetica;whiteSpace=nowrap;" vertex="1" parent="a_note"><mxGeometry x="10" y="0" width="1700" height="28" as="geometry"/></mxCell>
          <mxCell id="LEGEND" value="&lt;b&gt;Chú giải&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#DAE8FC&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; máy chủ ứng dụng &amp;nbsp;&lt;span style=&quot;background:#FFE6CC&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; CSDL / lưu trữ &amp;nbsp;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; web server &amp;nbsp;&lt;span style=&quot;background:#FFF2CC&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; artifact / môi trường thực thi &amp;nbsp;&lt;span style=&quot;background:#F5F5F5;border:1px solid #666&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; thiết bị / ngoài &amp;nbsp;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; ảo hóa / đám mây &amp;nbsp;&lt;span style=&quot;background:#F4CCCC&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; bảo mật&lt;br&gt;Khối 3D = node · hình chữ nhật «virtual» = node ảo (container/VM) · đám mây = hệ thống ngoài · hình trụ = kho dữ liệu · giấy gập góc = «artifact» · đường liền = communication path (giao thức/cổng) · nét đứt = phụ thuộc / sao lưu / triển khai · khung nét đứt = thành phần tùy chọn" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="a_note"><mxGeometry x="40" y="1410" width="840" height="110" as="geometry"/></mxCell>
          <mxCell id="SPECNOTE" value="&lt;b&gt;Lưu ý về thông số&lt;/b&gt;&lt;br&gt;Thông số phần cứng (vCPU, RAM, đĩa) là &lt;b&gt;[Đề xuất]&lt;/b&gt; suy từ giả định pilot (≤ 50 người dùng, ≤ 5 truy vấn đồng thời, ≤ 500 tài liệu; SAD §3.1.3), &lt;b&gt;chưa đo&lt;/b&gt;. IP, vùng, nhà cung cấp là &lt;b&gt;[TBD]&lt;/b&gt;: chờ OQ-008, OQ-011, OQ-022. Môi trường khác và khôi phục thảm họa ở trang 2; đặc tả đầy đủ ở trang 3." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="a_note"><mxGeometry x="900" y="1410" width="580" height="110" as="geometry"/></mxCell>
        </root>
      </mxGraphModel>
    </diagram>
