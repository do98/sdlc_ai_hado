          <mxCell id="bE4" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="b_conn"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="330" as="sourcePoint"/><mxPoint x="910" y="330" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="bE6" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;" edge="1" parent="b_conn"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="330" as="sourcePoint"/><mxPoint x="1350" y="330" as="targetPoint"/></mxGeometry></mxCell>
          <mxCell id="bT3" value="«promote»" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;fontStyle=2;" vertex="1" parent="b_label"><mxGeometry x="442" y="306" width="66" height="15" as="geometry"/></mxCell>
          <mxCell id="bT5" value="«promote»" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;fontStyle=2;" vertex="1" parent="b_label"><mxGeometry x="882" y="306" width="66" height="15" as="geometry"/></mxCell>
          <mxCell id="bT7" value="«restore»" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=none;spacing=1;whiteSpace=nowrap;fontStyle=2;" vertex="1" parent="b_label"><mxGeometry x="1322" y="306" width="66" height="15" as="geometry"/></mxCell>
          <mxCell id="bTT1" value="Môi trường triển khai — Dev · Staging · Production · Khôi phục thảm họa (DR) · theo SAD §4.4, §4.2" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontFamily=Helvetica;whiteSpace=nowrap;" vertex="1" parent="b_note"><mxGeometry x="10" y="0" width="1700" height="28" as="geometry"/></mxCell>
          <mxCell id="D_NOTE" value="Mục đích: phát triển, kiểm thử đơn vị.&lt;br&gt;Không chứa tài liệu thật.&lt;br&gt;Cấu hình Docker Compose là [Đề xuất]." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="b_note"><mxGeometry x="50" y="510" width="370" height="80" as="geometry"/></mxCell>
          <mxCell id="S_NOTE" value="Cổng vào production: kiểm thử E2E (US-P0), cô lập quyền (AC-020/021), đánh giá MET-002, quét phụ thuộc/bí mật, &lt;b&gt;phê duyệt tay&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="b_note"><mxGeometry x="490" y="510" width="370" height="80" as="geometry"/></mxCell>
          <mxCell id="P_NOTE" value="Dữ liệu thật chỉ ở đây. Nền tảng (đám mây / tự lưu trữ) và vùng: [TBD: OQ-008, OQ-011, OQ-022]. Không yêu cầu triển khai không ngừng ở MVP." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="b_note"><mxGeometry x="930" y="510" width="370" height="80" as="geometry"/></mxCell>
          <mxCell id="R_NOTE" value="&lt;b&gt;RPO ≤ 15 phút&lt;/b&gt; (CSDL), &lt;b&gt;≤ 24 giờ&lt;/b&gt; (PDF) · &lt;b&gt;RTO ≤ 4 giờ&lt;/b&gt; (giờ hành chính) [TBD: OQ-018]. Kiểm tra khôi phục trước pilot." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#888888;" vertex="1" parent="b_note"><mxGeometry x="1370" y="510" width="370" height="80" as="geometry"/></mxCell>
          <mxCell id="CMP" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;font-family:Helvetica;width:100%&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#E1D5E7;border:1px solid #9673A6;padding:4px 8px;text-align:left&quot;&gt;&lt;/th&gt;&lt;th style=&quot;background:#E1D5E7;border:1px solid #9673A6;padding:4px 8px;text-align:left&quot;&gt;Development&lt;/th&gt;&lt;th style=&quot;background:#E1D5E7;border:1px solid #9673A6;padding:4px 8px;text-align:left&quot;&gt;Staging&lt;/th&gt;&lt;th style=&quot;background:#E1D5E7;border:1px solid #9673A6;padding:4px 8px;text-align:left&quot;&gt;Production (pilot)&lt;/th&gt;&lt;th style=&quot;background:#E1D5E7;border:1px solid #9673A6;padding:4px 8px;text-align:left&quot;&gt;DR&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Mục đích&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Phát triển, kiểm thử đơn vị&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Kiểm thử tích hợp, E2E, đánh giá chất lượng&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Pilot với người dùng thật&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Khôi phục sau sự cố&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Dữ liệu&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Giả (seed)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Tổng hợp&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Thật&lt;/b&gt; (duy nhất)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Từ sao lưu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Nền tảng&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Docker Compose [Đề xuất]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Giống production, nhỏ hơn [Đề xuất]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;[TBD: OQ-008, OQ-011]&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Dựng khi cần, cùng nền tảng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Dịch vụ AI&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Mock / sandbox&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Sandbox / khóa riêng&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Dịch vụ thật qua egress&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Như production&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Số bản sao&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;1 mỗi thành phần&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Truy cập&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Nhà phát triển&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Nhà phát triển, QA&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Người dùng pilot được cấp quyền&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;Quản trị / SRE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;&lt;b&gt;Mục tiêu khôi phục&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:4px 8px;vertical-align:top&quot;&gt;RPO ≤ 15 phút (CSDL) / 24 giờ (PDF) · RTO ≤ 4 giờ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="b_note"><mxGeometry x="30" y="690" width="1730" height="220" as="geometry"/></mxCell>
        </root>
      </mxGraphModel>
